{
    "compilerOptions": {
        "target":               "ES2024",
        "module":               "ESNext",
        "moduleResolution":     "Bundler",
        "lib":                  ["dom", "dom.iterable", "esnext"],
        "types":                [],
        "strict":               true,
        "declaration":          true,
        "isolatedDeclarations": true,
        "noEmit":               true,
        "skipLibCheck":         true,
        "rootDir":              "src",
        "paths":                {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["test", "dist", "coverage", "vitest.config.ts", "tsdown.config.ts"]
}
